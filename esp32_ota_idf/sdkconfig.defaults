# Tabla de particiones custom (ver partitions.csv), equivalente al esquema
# OTA por defecto que usa el core de Arduino para ESP32 (4MB, ota_0/ota_1).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Equivalente a WiFiClientSecure::setInsecure() del original: no se valida
# el certificado del servidor en las conexiones HTTPS. Intencional, para
# mantener el mismo comportamiento que el firmware Arduino (sin mejoras de
# seguridad por ahora).
CONFIG_ESP_TLS_INSECURE=y
CONFIG_ESP_TLS_SKIP_SERVER_CERT_VERIFY=y

CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=n
